[Unit]
Description=Rasputinfy now-playing display server
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/rasputinfy
Environment=RASPUTINFY_STATE_PATH=/var/lib/rasputinfy/state.json
Environment=RASPUTINFY_HOST=127.0.0.1
Environment=RASPUTINFY_PORT=8765
ExecStart=/opt/rasputinfy/.venv/bin/python -m rasputinfy --host 127.0.0.1 --port 8765 --state-path /var/lib/rasputinfy/state.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
